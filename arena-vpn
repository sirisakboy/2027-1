#!/usr/bin/env bash
# ==============================================================================
#  Arena VPN — CLI หลัก
#  ออกแบบสำหรับ "VN บนคลาวด์ฟรี สำหรับงานพัฒนาโปรเจกต์ และใช้ยามฉุกเฉิน"
#
#  คำสั่งยอดนิยม
#    sudo arena-vpn init [--preset gcp|oracle|aws|generic] [--portal]
#    sudo arena-vpn peer add laptop            # สร้างอุปกรณ์ + ไฟล์เดียวจบ
#    sudo arena-vpn peer qr laptop             # QR สแกนจากมือถือ
#    sudo arena-vpn status                     # ดูสถานะรวม
#    sudo arena-vpn doctor [--fix]             # ตรวจ/ซ่อมเมื่อต่อไม่ได้
#    sudo arena-vpn portal open                # ลิงก์+รหัสพอร์ทัล
#    sudo arena-vpn failover rotate 2          # เปิดพอร์ต SSH ฉุกเฉินใหม่
#    sudo arena-vpn backup /root/vpn.tar.gz.enc
# ==============================================================================
