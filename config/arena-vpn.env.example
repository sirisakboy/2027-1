# ==============================================================================
#  Arena VPN — ไฟล์ตั้งค่า (ติดตั้งอัตโนมัติจาก `arena-vpn init`)
#  ไฟล์จริงอยู่ที่ /etc/arena-vpn/arena-vpn.env  (chmod 600)
#  แก้ผ่าน CLI: sudo arena-vpn config set KEY value
#  แล้วใช้:     sudo arena-vpn apply
# ==============================================================================

# ---------- ตัวตนของเซิร์ฟเวอร์ ----------
# ถ้าใช้โดเมน (แนะนำ) ใส่ เช่น vpn.example.com — ไม่งั้นปล่อยว่าง = ใช้ public IP
AVPN_PUBLIC_HOST=

# ---------- WireGuard (ช่องทางหลัก เร็วที่สุด) ----------
AVPN_WG_IF=wg0
AVPN_WG_PORT=51820
AVPN_WG_NET=10.8.0.0/24
AVPN_WG_SERVER_IP=10.8.0.1
AVPN_MTU=1420

# ---------- OpenVPN (ช่องทางสำรอง — ผ่านไฟร์วอลล์เข้มงวด) ----------
AVPN_OVPN_PORT=443
AVPN_OVPN_PROTO=tcp
AVPN_OVPN_NET=10.9.0.0/24
AVPN_OVPN_SERVER_IP=10.9.0.1
AVPN_OVPN_NET2=10.9.1.0/24
AVPN_OVPN_SERVER_IP2=10.9.1.1
# เปิด OpenVPN/UDP เพิ่มอีกพอร์ต (สำรองกรณี TCP 443 ถูกบล็อก)
AVPN_OVPN_UDP_ALT=1

# ---------- เส้นทางฉุกเฉิน (failover) ----------
# 1 = เปิดใช้ SSH หลายพอร์ต, 2 = สคริปต์สุ่มพอร์ตอัตโนมัติเมื่อท่อล่ม
AVPN_FALLBACK_ENABLED=1
AVPN_SSH_FALLBACK_PORTS=2222

# ---------- DNS ในอุโมงค์ (ตัดการรั่ว + กัน ISP ยุ่ง DNS) ----------
AVPN_DNS_ENABLED=1
AVPN_DNS_UPSTREAMS="9.9.9.9 1.1.1.1"
AVPN_CLIENT_DNS=10.8.0.1

# ---------- ความปลอดภัย ----------
# 1 = ปิด IPv6 ทั้งเครื่อง (กัน leak ตอน ISP ให้ IPv6)
AVPN_BLOCK_IPV6=1
AVPN_MAX_CLIENTS=8
# 1 = ไฟร์วอลล์โหด: เปิดเฉพาะ SSH/VPN/พอร์ทัล (ปิดพอร์ตอื่นทั้งหมด) แนะนำหลังตั้งค่าเสร็จ
AVPN_HARDENED_FIREWALL=0

# ---------- พอร์ทัลเว็บ (จัดการอุปกรณ์/ดาวน์โหลด config) ----------
AVPN_PORTAL_ENABLED=1
AVPN_PORTAL_PORT=8443
AVPN_PORTAL_TLS=1
AVPN_PORTAL_BIND=0.0.0.0

# ---------- ระบบ ----------
# การ์ดเครือข่ายขาออก (NAT) — ปล่อยว่าง = ตรวจอัตโนมัติ
AVPN_EGRESS_IF=
